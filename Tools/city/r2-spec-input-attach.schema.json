{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fluxverse.local/r2-spec-input/attach-node.schema.json",
  "title": "R2 SPEC-INPUT ATTACH node line (3 rows: N4 attach)",
  "description": "Structural gate for the ATTACH-JSON block embedded in docs/research/R-20261012-ad022-r2-spec-input.md section 2. branch_aligned_cells minItems=1 encodes filter-gate-1 (branch reality test: >=1 branch-axis-aligned SEG cell) positively.",
  "type": "object",
  "definitions": {
    "cell2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "occ-string": {"type": "string", "pattern": "^Road_[A-Za-z0-9_]+@\\(-?[0-9.]+(?:[eE][-+]?[0-9]+)?,-?[0-9.]+(?:[eE][-+]?[0-9]+)?\\)y[0-9]+M?$"}
  },
  "required": ["branch", "branch_aligned_cells", "cell", "class", "trunk", "verdict"],
  "additionalProperties": false,
  "properties": {
    "branch": {"type": "object", "required": ["axis", "far_role", "fixed", "j_idx", "n", "span"], "additionalProperties": false, "properties": {"axis": {"enum": ["EW", "NS"]}, "far_role": {"const": "own-end"}, "fixed": {"type": "number"}, "j_idx": {"type": "integer", "minimum": 0}, "n": {"type": "integer", "minimum": 1}, "span": {"$ref": "#/definitions/cell2"}}},
    "branch_aligned_cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cell2"}},
    "cell": {"$ref": "#/definitions/cell2"},
    "class": {"const": "N4-attach"},
    "trunk": {"type": "object", "required": ["axis", "fixed", "j_piece", "j_pos", "main_yaw", "n", "span"], "additionalProperties": false, "properties": {"axis": {"enum": ["EW", "NS"]}, "fixed": {"type": "number"}, "j_piece": {"$ref": "#/definitions/occ-string"}, "j_pos": {"enum": ["interior", "end"]}, "main_yaw": {"type": "integer", "minimum": 0, "maximum": 359}, "n": {"type": "integer", "minimum": 1}, "span": {"$ref": "#/definitions/cell2"}}},
    "verdict": {"const": "STOP-ADJ"}
  }
}
