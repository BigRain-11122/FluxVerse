{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fluxverse.local/r2-spec-input/fill-plaza.schema.json",
  "title": "R2 SPEC-INPUT FILL plaza line (1 row: face-fill domain)",
  "description": "Structural gate for the FILL-JSON block embedded in docs/research/R-20261012-ad022-r2-spec-input.md section 5. Zero-gateway law (gateway_cells empty, fully isolated face-domain island) is enforced by the companion validator tally, not by schema (array may legally carry future gateway cells).",
  "type": "object",
  "definitions": {
    "cell2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
  },
  "required": ["bare_deg_spectrum", "box", "cells", "cols", "domain", "gateway_cells", "non_plaza_box_cells", "occupied", "rows", "rules"],
  "additionalProperties": false,
  "properties": {
    "bare_deg_spectrum": {"type": "object", "minProperties": 1, "patternProperties": {"^[0-9]+$": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "cells": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["box_pos", "cell", "deg", "fam", "gateway_dirs", "yaw"], "additionalProperties": false, "properties": {"box_pos": {"enum": ["edge", "corner", "interior"]}, "cell": {"$ref": "#/definitions/cell2"}, "deg": {"type": "integer", "minimum": 2, "maximum": 4}, "fam": {"type": "string", "pattern": "^Road_[A-Za-z0-9_]+$"}, "gateway_dirs": {"type": "array", "items": {"enum": ["N", "S", "E", "W"]}}, "yaw": {"type": "integer", "minimum": 0, "maximum": 360}}}},
    "cols": {"type": "integer", "minimum": 1},
    "domain": {"const": "FILL"},
    "gateway_cells": {"type": "array", "items": {"$ref": "#/definitions/cell2"}},
    "non_plaza_box_cells": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": [{"type": "number"}, {"type": "number"}, {"enum": ["MARK-ONLY", "EMPTY"]}], "additionalItems": false}},
    "occupied": {"type": "integer", "minimum": 1},
    "rows": {"type": "integer", "minimum": 1},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
